@* Einheitlicher Seitenkopf mit Titel, Untertitel und Aktionsbereich. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-6 gap-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @if (!string.IsNullOrEmpty(BackHref))
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@BackHref" aria-label="Zurück" />
        }
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <MudIcon Icon="@Icon" Class="mr-2 mb-1" />
                }
                @Title
            </MudText>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="Typo.body2" Color="Color.Primary">@Subtitle</MudText>
            }
        </MudStack>
    </MudStack>
    @if (Actions != null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            @Actions
        </MudStack>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}

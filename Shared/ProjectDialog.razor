@* Dialog zum Anlegen oder Umbenennen eines Projekts. Ergebnis: (Name, Icon). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.CreateNewFolder)" Class="mr-2 mb-1" />
            @(IsEdit ? "Projekt bearbeiten" : "Neues Projekt")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="4">
                <MudTextField @bind-Value="Name"
                              Label="Projektname"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Name ist erforderlich"
                              MaxLength="60"
                              Immediate="true"
                              AutoFocus="true" />
                <MudSelect @bind-Value="Icon" Label="Symbol" Variant="Variant.Outlined">
                    @foreach (var (key, icon) in ProjectIcons)
                    {
                        <MudSelectItem Value="@key">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@icon" Size="Size.Small" />
                                <MudText>@key</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (!IsEdit)
                {
                    <MudText Typo="Typo.caption">
                        Das Projekt wird mit Standardkategorien und einem Girokonto angelegt.
                        Daten verschiedener Projekte sind strikt voneinander getrennt.
                    </MudText>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            @(IsEdit ? "Speichern" : "Anlegen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "Projekt";
    [Parameter] public bool IsEdit { get; set; }

    private MudForm? _form;
    private bool _valid;

    private async Task Submit()
    {
        if (_form != null) await _form.Validate();
        if (_form?.IsValid != true) return;
        MudDialog.Close(DialogResult.Ok((Name.Trim(), Icon)));
    }
}

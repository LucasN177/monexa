@page "/budgets"
@inherits FinancePage
@inject PreferencesService Preferences

<PageTitle>Budgets – MonExA</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    @* ── Header ── *@
    <PageHeader Title="Budgets" Icon="@Icons.Material.Filled.AccountBalanceWallet"
                Subtitle="@($"Verwalte deine Ausgabenlimits – Stichtag {Date(_reference)}")">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _reference = _reference.AddMonths(-1))" />
            <MudText Typo="Typo.subtitle1" Style="min-width:130px; text-align:center;">@MonthYear(_reference)</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Variant="Variant.Outlined" Size="Size.Small"
                           Disabled="@IsCurrentMonth" OnClick="@(() => _reference = MoveForward())" />
            @if (Finance.CanEdit)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    Neues Budget
                </MudButton>
            }
        </Actions>
    </PageHeader>

    @* ── KPI Summary Cards (auf Monat umgerechnet) ── *@
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <StatCard Title="Gesamtbudget / Monat" Value="@MoneyShort(TotalBudget)" Caption="@($"{CategoryBudgets.Count()} Kategorie-Budgets")" Icon="@Icons.Material.Filled.AccountBalanceWallet" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <StatCard Title="Ausgegeben" Value="@MoneyShort(TotalSpent)" ValueColor="Color.Error" Caption="@($"{Percent(SpentPercent)} des Gesamtbudgets")" Icon="@Icons.Material.Filled.ShoppingCart" IconColor="Color.Error" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <StatCard Title="Verbleibend" Value="@MoneyShort(TotalBudget - TotalSpent)" ValueColor="@(TotalBudget - TotalSpent >= 0 ? Color.Success : Color.Error)"
                      Caption="noch verfügbar" Icon="@Icons.Material.Filled.Savings" IconColor="Color.Success" />
        </MudItem>
    </MudGrid>

    @* ── Filter / Search Bar ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Budget suchen…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Class="flex-grow-1" />
        <MudSelect T="BudgetPeriod?" @bind-Value="_selectedPeriod"
                   Label="Zeitraum"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Style="min-width:160px;">
            @foreach (var period in Enum.GetValues<BudgetPeriod>())
            {
                <MudSelectItem T="BudgetPeriod?" Value="@period">@PeriodText(period)</MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="Nur Überschreitungen anzeigen">
            <MudToggleIconButton @bind-Toggled="_showOnlyOverBudget"
                                 Icon="@Icons.Material.Filled.FilterAlt"
                                 ToggledIcon="@Icons.Material.Filled.FilterAlt"
                                 ToggledColor="Color.Error" />
        </MudTooltip>
    </MudStack>

    @* ── Budget Cards ── *@
    @if (!FilteredBudgets.Any())
    {
        <EmptyState Title="Keine Budgets gefunden" Text="Passe deine Filter an oder erstelle ein neues Budget.">
            @if (Finance.CanEdit && !Finance.Budgets.Any())
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Erstes Budget anlegen</MudButton>
            }
        </EmptyState>
    }
    else
    {
        <MudGrid>
            @foreach (var b in FilteredBudgets)
            {
                var budget = b.Budget;
                var percent = b.Percent;
                var progressColor = percent >= 100 ? Color.Error : percent >= Preferences.BudgetWarningPercent ? Color.Warning : Color.Success;
                var remaining = budget.Limit - b.Spent;

                <MudItem xs="12" sm="6" md="4">
                    <MudCard Outlined="true" Elevation="0">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="@ParseColor(budget.Color)" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icon(budget.Icon)" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1">@budget.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Primary">
                                    @PeriodText(budget.Period) · @(budget.CategoryId == null ? "Alle Ausgaben" : Finance.CategoryName(budget.CategoryId))
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                                    @if (budget.CategoryId != null)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Receipt" Href="@($"transaktionen?kategorie={budget.CategoryId}")">Transaktionen</MudMenuItem>
                                    }
                                    @if (Finance.CanEdit)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(budget))">Bearbeiten</MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => ConfirmDelete(budget))">
                                            <MudText Color="Color.Error">Löschen</MudText>
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent>
                            @* Progress Bar *@
                            <MudProgressLinear Value="@Math.Min(percent, 100)"
                                               Color="@progressColor"
                                               Rounded="true"
                                               Size="Size.Medium"
                                               Class="mb-2" />

                            @* Spent / Limit *@
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2">
                                    Ausgegeben: <strong>@MoneyShort(b.Spent)</strong>
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    Limit: <strong>@MoneyShort(budget.Limit)</strong>
                                </MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption">@Date(b.Start) – @Date(b.End.AddDays(-1))</MudText>

                            @* Status Chip *@
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                                @if (remaining < 0)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning" Variant="Variant.Filled">
                                        @MoneyShort(Math.Abs(remaining)) überschritten
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Text">
                                        @MoneyShort(remaining) verbleibend
                                    </MudChip>
                                }
                                <MudText Typo="Typo.caption" Color="@progressColor">@percent.ToString("0")%</MudText>
                            </MudStack>

                            @if (b.Forecast.HasValue && remaining >= 0)
                            {
                                <MudText Typo="Typo.caption" Color="@(b.Forecast > budget.Limit ? Color.Warning : Color.Default)" Class="mt-1 d-block">
                                    <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" Style="vertical-align: middle;" />
                                    Hochrechnung bis Periodenende: @MoneyShort(b.Forecast.Value)
                                    @if (b.Forecast > budget.Limit) { <span>– Limit wird voraussichtlich überschritten</span> }
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@* ── Create / Edit Dialog ── *@
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_editingBudget == null ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-2 mb-1" />
            @(_editingBudget == null ? "Neues Budget" : "Budget bearbeiten")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValid" Class="pa-2">
            <MudStack Spacing="4">
                <MudSelect T="Guid?" Value="_dialogModel.CategoryId" ValueChanged="OnCategoryChanged"
                           Label="Kategorie"
                           Variant="Variant.Outlined"
                           HelperText="Gegen welche Ausgaben läuft das Limit?">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Alle Ausgaben</MudSelectItem>
                    @foreach (var category in Finance.Categories.Where(c => c.Type == CategoryType.Ausgabe))
                    {
                        <MudSelectItem T="Guid?" Value="@category.Id">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icon(category.Icon)" Size="Size.Small" Color="@ParseColor(category.Color)" />
                                <MudText>@category.Name</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_dialogModel.Name"
                              Label="Bezeichnung"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Pflichtfeld"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Label" />

                <MudNumericField @bind-Value="_dialogModel.Limit"
                                 Label="Limit (€)"
                                 Variant="Variant.Outlined"
                                 Required="true"
                                 RequiredError="Pflichtfeld"
                                 Validation="@(new Func<decimal, string?>(v => v > 0 ? null : "Limit muss größer als 0 sein"))"
                                 Min="0m"
                                 Format="N2"
                                 Culture="@De"
                                 HideSpinButtons="true"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Euro" />

                <MudSelect @bind-Value="_dialogModel.Period"
                           Label="Zeitraum"
                           Variant="Variant.Outlined"
                           Required="true">
                    @foreach (var period in Enum.GetValues<BudgetPeriod>())
                    {
                        <MudSelectItem Value="@period">@PeriodText(period)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="_dialogModel.Icon"
                           Label="Symbol"
                           Variant="Variant.Outlined">
                    @foreach (var (label, icon) in CategoryIcons)
                    {
                        <MudSelectItem Value="@label">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@icon" Size="Size.Small" />
                                <MudText>@label</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="_dialogModel.Color"
                           Label="Farbe"
                           Variant="Variant.Outlined">
                    @foreach (var (key, label, color) in ColorOptions)
                    {
                        <MudSelectItem Value="@key">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="@color" Size="Size.Small" />
                                <MudText>@label</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text">Abbrechen</MudButton>
        <MudButton OnClick="SaveBudget"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                  
                   StartIcon="@Icons.Material.Filled.Save">
            Speichern
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    private record BudgetView(Budget Budget, decimal Spent, double Percent, DateTime Start, DateTime End, decimal? Forecast);

    // ── State ─────────────────────────────────────────────────────────────────

    private DateTime _reference = DateTime.Today;
    private string _searchText = string.Empty;
    private BudgetPeriod? _selectedPeriod;
    private bool _showOnlyOverBudget;

    private MudForm? _form;
    private bool _formValid;
    private bool _dialogVisible;
    private Budget? _editingBudget;
    private Budget _dialogModel = new();

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    // ── Computed ──────────────────────────────────────────────────────────────

    private bool IsCurrentMonth => _reference.Year == DateTime.Today.Year && _reference.Month == DateTime.Today.Month;

    private DateTime MoveForward()
    {
        var next = _reference.AddMonths(1);
        // Im laufenden Monat immer "heute" als Stichtag, sonst Monatsende.
        return next.Year == DateTime.Today.Year && next.Month == DateTime.Today.Month
            ? DateTime.Today
            : FinanceState.MonthStart(next).AddMonths(1).AddDays(-1);
    }

    private IEnumerable<BudgetView> AllViews => Finance.Budgets.Select(budget =>
    {
        var reference = IsCurrentMonth ? DateTime.Today : FinanceState.MonthStart(_reference).AddMonths(1).AddDays(-1);
        var (start, end) = FinanceState.PeriodRange(budget.Period, reference);
        var spent = Finance.BudgetSpent(budget, reference);
        var percent = budget.Limit > 0 ? (double)(spent / budget.Limit * 100) : 0;

        decimal? forecast = null;
        var today = DateTime.Today;
        if (today >= start && today < end)
        {
            var elapsed = (today - start).Days + 1;
            var total = (end - start).Days;
            if (elapsed >= 3 && elapsed < total) forecast = Math.Round(spent / elapsed * total, 0);
        }
        return new BudgetView(budget, spent, percent, start, end, forecast);
    });

    private IEnumerable<BudgetView> FilteredBudgets => AllViews
        .Where(b => string.IsNullOrWhiteSpace(_searchText)
                    || b.Budget.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(b => _selectedPeriod == null || b.Budget.Period == _selectedPeriod)
        .Where(b => !_showOnlyOverBudget || b.Spent > b.Budget.Limit)
        .OrderByDescending(b => b.Percent);

    /// <summary>Budgets mit Kategorie – das "Alle Ausgaben"-Budget würde sonst doppelt zählen.</summary>
    private IEnumerable<Budget> CategoryBudgets => Finance.Budgets.Where(b => b.CategoryId != null);

    private decimal TotalBudget => CategoryBudgets.Sum(FinanceState.MonthlyLimit);

    private decimal TotalSpent
    {
        get
        {
            var month = FinanceState.MonthStart(_reference);
            var ids = CategoryBudgets.Select(b => b.CategoryId).ToHashSet();
            return Finance.InRange(month, month.AddMonths(1))
                .Where(t => t.Type == TransactionType.Ausgabe && ids.Contains(t.CategoryId))
                .Sum(t => t.Amount);
        }
    }

    private double SpentPercent => TotalBudget > 0 ? (double)(TotalSpent / TotalBudget * 100) : 0;

    // ── Dialog Handlers ───────────────────────────────────────────────────────

    private void OpenCreateDialog()
    {
        _editingBudget = null;
        _dialogModel = new Budget { Icon = "Shopping", Color = "Primary" };
        _dialogVisible = true;
    }

    private void OpenEditDialog(Budget budget)
    {
        _editingBudget = budget;
        _dialogModel = budget.Clone();
        _dialogVisible = true;
    }

    private void OnCategoryChanged(Guid? categoryId)
    {
        var previous = Finance.GetCategory(_dialogModel.CategoryId);
        _dialogModel.CategoryId = categoryId;
        var category = Finance.GetCategory(categoryId);
        // Name/Icon/Farbe übernehmen, solange der Nutzer sie nicht selbst angepasst hat.
        if (string.IsNullOrWhiteSpace(_dialogModel.Name) || _dialogModel.Name == previous?.Name || _dialogModel.Name == "Gesamtausgaben")
            _dialogModel.Name = category?.Name ?? "Gesamtausgaben";
        if (category != null)
        {
            _dialogModel.Icon = category.Icon;
            _dialogModel.Color = category.Color;
        }
    }

    private void CloseDialog() => _dialogVisible = false;

    private async Task SaveBudget()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid) return;

        if (Finance.Budgets.Any(b => b.Id != _dialogModel.Id && b.CategoryId == _dialogModel.CategoryId && b.Period == _dialogModel.Period))
        {
            Snackbar.Add("Für diese Kategorie und diesen Zeitraum existiert bereits ein Budget.", Severity.Warning);
            return;
        }

        if (await Finance.SaveBudgetAsync(_dialogModel))
        {
            Snackbar.Add(_editingBudget == null ? "Budget angelegt." : "Budget gespeichert.", Severity.Success);
            CloseDialog();
        }
    }

    private async Task ConfirmDelete(Budget budget)
    {
        if (!await ConfirmAsync("Budget löschen",
                $"Soll das Budget <strong>{budget.Name}</strong> wirklich gelöscht werden? Diese Aktion kann nicht rückgängig gemacht werden."))
            return;
        if (await Finance.DeleteBudgetAsync(budget.Id))
            Snackbar.Add("Budget gelöscht.", Severity.Success);
    }
}

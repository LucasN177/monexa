@page "/konten"
@inherits FinancePage

<PageTitle>Kontenverwaltung – MonExA</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    <PageHeader Title="Kontenverwaltung" Subtitle="Alle Konten des Projekts und ihre aktuellen Salden">
        <Actions>
            @if (Finance.CanEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="konten/neu">
                    Neues Konto
                </MudButton>
            }
        </Actions>
    </PageHeader>

    <!-- Statistik Cards -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Gesamtguthaben" Value="@Money(Finance.NetWorth)"
                      ValueColor="@(Finance.NetWorth >= 0 ? Color.Success : Color.Error)"
                      Caption="Summe aller aktiven Konten" Icon="@Icons.Material.Filled.AccountBalance" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Liquide Mittel" Value="@Money(LiquidBalance)"
                      Caption="Giro, Tagesgeld & Sparkonten" Icon="@Icons.Material.Filled.Payments" IconColor="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Aktive Konten" Value="@Finance.Accounts.Count(a => a.IsActive).ToString()" ValueColor="Color.Info"
                      Caption="@($"von {Finance.Accounts.Count} Konten")" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Verbindlichkeiten" Value="@Money(Debts)" ValueColor="@(Debts < 0 ? Color.Error : Color.Default)"
                      Caption="Negative Kontostände" Icon="@Icons.Material.Filled.CreditCard" IconColor="Color.Warning" />
        </MudItem>
    </MudGrid>

    <!-- Action Bar -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="gap-2">
            <MudTextField @bind-Value="searchString"
                          Placeholder="Konten durchsuchen..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Clearable="true"
                          Style="max-width: 400px;" />
            <MudSwitch T="bool" @bind-Value="showInactive" Label="Inaktive anzeigen" Color="Color.Primary" />
        </MudStack>
    </MudPaper>

    <!-- Konten Table -->
    <MudTable Items="@GetFilteredAccounts()"
              Hover="true"
              Striped="true"
              Dense="true"
              Elevation="0"
              Outlined="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="@((TableRowClickEventArgs<Konto> e) => ViewDetails(e.Item!))"
              RowStyle="cursor: pointer;">
        <HeaderContent>
            <MudTh>Status</MudTh>
            <MudTh><MudTableSortLabel T="Konto" SortBy="a => a.Name">Kontoname</MudTableSortLabel></MudTh>
            <MudTh>Kontotyp</MudTh>
            <MudTh>IBAN</MudTh>
            <MudTh Style="text-align: right;"><MudTableSortLabel T="Konto" SortBy="a => a.Balance">Kontostand</MudTableSortLabel></MudTh>
            <MudTh>Währung</MudTh>
            <MudTh>Bank</MudTh>
            <MudTh Style="text-align: center;">Aktionen</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.IsActive ? Color.Success : Color.Default)"
                         Variant="Variant.Filled">
                    @(context.IsActive ? "Aktiv" : "Inaktiv")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Kontoname">
                <MudText Typo="Typo.body2"><strong>@context.Name</strong></MudText>
            </MudTd>
            <MudTd DataLabel="Kontotyp">
                <MudChip T="string" Size="Size.Small" Icon="@AccountTypeIcon(context.Type)" Color="@AccountTypeColor(context.Type)">
                    @AccountTypeText(context.Type)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="IBAN">
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@(string.IsNullOrEmpty(context.IBAN) ? "–" : context.IBAN)</MudText>
            </MudTd>
            <MudTd DataLabel="Kontostand" Style="text-align: right;">
                <MudText Typo="Typo.body2" Color="@(context.Balance >= 0 ? Color.Success : Color.Error)">
                    <strong>@Money(context.Balance)</strong>
                </MudText>
            </MudTd>
            <MudTd DataLabel="Währung">@context.Currency</MudTd>
            <MudTd DataLabel="Bank">@context.BankName</MudTd>
            <MudTd DataLabel="Aktionen" Style="text-align: center; white-space: nowrap;">
                <span @onclick:stopPropagation="true">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Size="Size.Small"
                               OnClick="@(() => ViewDetails(context))"
                               title="Details" />
                @if (Finance.CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Href="@($"konten/{context.Id}/bearbeiten")"
                                   title="Bearbeiten" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteAccount(context))"
                                   title="Löschen" />
                }
                </span>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">
                Keine Konten gefunden.
            </MudText>
        </NoRecordsContent>
    </MudTable>

    @if (Finance.Accounts.Any(a => a.Currency != "EUR"))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text" Class="mt-2">
            Fremdwährungskonten werden in Summen ohne Umrechnung berücksichtigt.
        </MudAlert>
    }
</MudContainer>

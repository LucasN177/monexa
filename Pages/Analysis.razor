@page "/analysis"
@inherits FinancePage
@inject PreferencesService Preferences

<PageTitle>Budget-Analyse – MonExA</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    @* ── Header ── *@
    <PageHeader Title="Budget-Analyse" Icon="@Icons.Material.Filled.BarChart" Subtitle="Detaillierte Auswertung deiner Ausgaben">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="PreviousMonth" />
            <MudText Typo="Typo.subtitle1" Style="min-width:140px; text-align:center;">
                @MonthYear(_currentMonth)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="NextMonth"
                           Disabled="@(_currentMonth >= FinanceState.MonthStart(DateTime.Today))" />
        </Actions>
    </PageHeader>

    @* ── KPI Row ── *@
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Gesamtbudget" Value="@Money(TotalBudget)" Caption="@($"{_budgets.Count} Kategorien")" Icon="@Icons.Material.Filled.AccountBalanceWallet" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Ausgegeben" Value="@Money(TotalSpent)" ValueColor="Color.Error" Caption="@($"{SpentPercent:0}% des Budgets")" Icon="@Icons.Material.Filled.TrendingUp" IconColor="Color.Error" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Verbleibend" Value="@Money(TotalRemaining)" ValueColor="@(TotalRemaining >= 0 ? Color.Success : Color.Error)" Caption="noch verfügbar" Icon="@Icons.Material.Filled.Savings" IconColor="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Title="Überschreitungen" Value="@OverBudgetCount.ToString()" ValueColor="Color.Warning"
                      Caption="@((OverBudgetCount == 1 ? "Kategorie" : "Kategorien") + " über Limit")" Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning" />
        </MudItem>
    </MudGrid>

    @if (!_budgets.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">
            Für dieses Projekt sind noch keine Kategorie-Budgets angelegt. <MudLink Href="budgets">Jetzt Budgets anlegen</MudLink>,
            um Auslastung und Überschreitungen zu sehen.
        </MudAlert>
    }

    @* ── Gesamtfortschritt ── *@
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-6">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle1">Gesamtfortschritt</MudText>
                <MudText Typo="Typo.subtitle2" Color="@UsageColor(SpentPercent)">
                    @SpentPercent.ToString("0.0")%
                </MudText>
            </MudStack>
            <MudProgressLinear Value="@Math.Min(SpentPercent, 100)"
                               Color="@UsageColor(SpentPercent)"
                               Rounded="true"
                               Size="Size.Large" />
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Primary">0 €</MudText>
                <MudText Typo="Typo.caption" Color="Color.Primary">@Money(TotalBudget)</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>

    @* ── Ausgabenverlauf ── *@
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-6">
        <MudText Typo="Typo.subtitle1">Kumulierte Ausgaben im Monatsverlauf</MudText>
        <MudChart ChartType="ChartType.Line" ChartSeries="@_burnSeries" XAxisLabels="@_burnLabels" ChartOptions="@_chartOptions" Width="100%" Height="260px" />
    </MudPaper>

    @* ── Haupt-Inhalt: Tabelle + Seitenleiste ── *@
    <MudGrid>

        @* ── Kategorie-Tabelle ── *@
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-4 pb-0" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle1">Kategorien im Detail</MudText>
                    <MudStack Row="true" Spacing="1">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_tableFilter == "all" ? Color.Primary : Color.Default)"
                                 Variant="@(_tableFilter == "all" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => _tableFilter = "all")">
                            Alle
                        </MudChip>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_tableFilter == "over" ? Color.Error : Color.Default)"
                                 Variant="@(_tableFilter == "over" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => _tableFilter = "over")">
                            Überschritten
                        </MudChip>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_tableFilter == "ok" ? Color.Success : Color.Default)"
                                 Variant="@(_tableFilter == "ok" ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => _tableFilter = "ok")">
                            Im Rahmen
                        </MudChip>
                    </MudStack>
                </MudStack>

                <MudTable Items="@FilteredTableBudgets"
                          Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          Class="mt-2">
                    <HeaderContent>
                        <MudTh>Kategorie</MudTh>
                        <MudTh Style="text-align:right">Budget</MudTh>
                        <MudTh Style="text-align:right">Ausgegeben</MudTh>
                        <MudTh Style="text-align:right">Rest</MudTh>
                        <MudTh Style="min-width:120px">Auslastung</MudTh>
                        <MudTh Style="text-align:center">Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Kategorie">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="@context.AvatarColor" Size="Size.Small" Variant="Variant.Filled">
                                    <MudIcon Icon="@context.Icon" Size="Size.Small" />
                                </MudAvatar>
                                <MudText Typo="Typo.body2">@context.Name</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Budget" Style="text-align:right">
                            <MudText Typo="Typo.body2">@Money(context.Limit)</MudText>
                        </MudTd>
                        <MudTd DataLabel="Ausgegeben" Style="text-align:right">
                            <MudText Typo="Typo.body2" Color="@(context.Spent > context.Limit ? Color.Error : Color.Default)">
                                @Money(context.Spent)
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Rest" Style="text-align:right">
                            <MudText Typo="Typo.body2" Color="@(context.Remaining < 0 ? Color.Error : Color.Success)">
                                @Money(context.Remaining)
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Auslastung">
                            <MudStack Spacing="1">
                                <MudProgressLinear Value="@Math.Min(context.Percent, 100)" Color="@StatusColor(context.Percent)" Rounded="true" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="@StatusColor(context.Percent)">@context.Percent.ToString("0")%</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Status" Style="text-align:center">
                            @if (context.Percent >= 100)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ErrorOutline">Überzogen</MudChip>
                            }
                            else if (context.Percent >= Preferences.BudgetWarningPercent)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.WarningAmber">Kritisch</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircleOutline">OK</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="pa-4">Keine Einträge für diesen Filter.</MudText>
                    </NoRecordsContent>
                    <FooterContent>
                        <MudTd>
                            <MudText Typo="Typo.subtitle2">Gesamt</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.subtitle2">@Money(TotalBudget)</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.subtitle2" Color="Color.Error">@Money(TotalSpent)</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.subtitle2" Color="@(TotalRemaining >= 0 ? Color.Success : Color.Error)">@Money(TotalRemaining)</MudText>
                        </MudTd>
                        <MudTd colspan="2" />
                    </FooterContent>
                </MudTable>

                @if (_unbudgetedSpent > 0)
                {
                    <MudText Typo="Typo.caption" Class="pa-4 d-block">
                        Zusätzlich @Money(_unbudgetedSpent) Ausgaben in Kategorien ohne Budget.
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        @* ── Seitenleiste: Top-Ausgaben + Insights ── *@
        <MudItem xs="12" md="4">
            <MudStack Spacing="4">

                @* Top-Ausgaben *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">Top-Ausgaben</MudText>
                    @if (!_topCategories.Any())
                    {
                        <MudText Typo="Typo.body2">Keine Ausgaben in diesem Monat.</MudText>
                    }
                    @foreach (var (item, rank) in _topCategories.Select((x, i) => (x, i + 1)))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="min-width:16px">@rank</MudText>
                            <MudAvatar Color="@item.AvatarColor" Size="Size.Small" Variant="Variant.Filled">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            </MudAvatar>
                            <MudStack Spacing="0" Class="flex-grow-1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">@item.Name</MudText>
                                    <MudText Typo="Typo.body2" Color="@(item.Limit > 0 && item.Spent > item.Limit ? Color.Error : Color.Default)">
                                        @Money(item.Spent)
                                    </MudText>
                                </MudStack>
                                <MudProgressLinear Value="@(TotalSpentAll > 0 ? (double)(item.Spent / TotalSpentAll * 100) : 0)"
                                                   Color="@(item.Limit > 0 ? StatusColor(item.Percent) : Color.Primary)"
                                                   Rounded="true"
                                                   Size="Size.Small" />
                            </MudStack>
                        </MudStack>
                    }
                </MudPaper>

                @* Insights *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">Insights</MudText>
                    <MudStack Spacing="2">
                        @foreach (var insight in Insights)
                        {
                            <MudAlert Severity="@insight.Severity" Dense="true" Variant="Variant.Text" Icon="@insight.Icon">
                                @insight.Text
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>

                @* Monatsvergleich *@
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">Monatsvergleich</MudText>
                    <MudStack Spacing="3">
                        @foreach (var entry in _monthlyComparison)
                        {
                            <MudStack Spacing="1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption" Color="Color.Primary">@entry.Label</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.caption">@Money(entry.Amount)</MudText>
                                        @if (Math.Abs(entry.DeltaPercent) >= 0.5)
                                        {
                                            <MudIcon Icon="@(entry.DeltaPercent > 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                                     Size="Size.Small"
                                                     Color="@(entry.DeltaPercent > 0 ? Color.Error : Color.Success)" />
                                            <MudText Typo="Typo.caption" Color="@(entry.DeltaPercent > 0 ? Color.Error : Color.Success)">
                                                @Math.Abs(entry.DeltaPercent).ToString("0")%
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudStack>
                                <MudProgressLinear Value="@entry.FillPercent" Color="Color.Primary" Rounded="true" Size="Size.Small" />
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>

            </MudStack>
        </MudItem>
    </MudGrid>

    @* ── Transaktionen (expandierbar pro Kategorie) ── *@
    <MudText Typo="Typo.subtitle1" Class="mt-6 mb-3">Transaktionen nach Kategorie</MudText>
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
        @foreach (var item in _topCategories)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Color="@item.AvatarColor" Size="Size.Small" Variant="Variant.Filled">
                            <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle2">@item.Name</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="d-none d-sm-flex">
                            @item.Transactions.Count Transaktionen
                        </MudText>
                        <MudText Typo="Typo.body2" Color="@(item.Limit > 0 && item.Spent > item.Limit ? Color.Error : Color.Default)">
                            @Money(item.Spent)
                        </MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudTable Items="@item.Transactions" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Xs"
                              OnRowClick="@((TableRowClickEventArgs<Transaction> e) => Navigation.NavigateTo($"transaktionen/{e.Item!.Id}/bearbeiten"))"
                              RowStyle="cursor: pointer;">
                        <HeaderContent>
                            <MudTh>Datum</MudTh>
                            <MudTh>Beschreibung</MudTh>
                            <MudTh>Konto</MudTh>
                            <MudTh Style="text-align:right">Betrag</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Datum"><MudText Typo="Typo.body2" Color="Color.Primary">@Date(context.Date)</MudText></MudTd>
                            <MudTd DataLabel="Beschreibung"><MudText Typo="Typo.body2">@context.Description</MudText></MudTd>
                            <MudTd DataLabel="Konto"><MudText Typo="Typo.body2">@Finance.AccountName(context.AccountId)</MudText></MudTd>
                            <MudTd DataLabel="Betrag" Style="text-align:right"><MudText Typo="Typo.body2" Color="Color.Error">@Money(context.Amount)</MudText></MudTd>
                        </RowTemplate>
                    </MudTable>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
</MudContainer>

@code {

    // ── Models ────────────────────────────────────────────────────────────────

    private class CategoryRow
    {
        public Guid? CategoryId { get; init; }
        public string Name { get; init; } = string.Empty;
        public decimal Limit { get; init; }
        public decimal Spent { get; init; }
        public string Icon { get; init; } = Icons.Material.Filled.Category;
        public Color AvatarColor { get; init; } = Color.Primary;
        public List<Transaction> Transactions { get; init; } = new();
        public decimal Remaining => Limit - Spent;
        public double Percent => Limit > 0 ? (double)(Spent / Limit * 100) : 0;
    }

    private record InsightItem(string Text, Severity Severity, string Icon);

    private record MonthEntry(string Label, decimal Amount, double DeltaPercent, double FillPercent);

    // ── State ─────────────────────────────────────────────────────────────────

    private DateTime _currentMonth = FinanceState.MonthStart(DateTime.Today);
    private string _tableFilter = "all";
    private List<CategoryRow> _budgets = new();
    private List<CategoryRow> _topCategories = new();
    private List<MonthEntry> _monthlyComparison = new();
    private decimal _unbudgetedSpent;
    private decimal _income;
    private List<ChartSeries> _burnSeries = new();
    private string[] _burnLabels = Array.Empty<string>();
    private readonly ChartOptions _chartOptions = new() { YAxisFormat = "N0", MaxNumYAxisTicks = 6 };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Compute();
    }

    protected override void OnDataChanged() => Compute();

    private void Compute()
    {
        var start = _currentMonth;
        var end = start.AddMonths(1);
        var expenses = Finance.InRange(start, end).Where(t => t.Type == TransactionType.Ausgabe).ToList();
        _income = Finance.Income(start, end);

        CategoryRow BuildRow(Guid? categoryId, decimal limit, string? name = null, string? icon = null, string? color = null)
        {
            var category = Finance.GetCategory(categoryId);
            var transactions = expenses.Where(t => t.CategoryId == categoryId).OrderByDescending(t => t.Date).ToList();
            return new CategoryRow
            {
                CategoryId = categoryId,
                Name = name ?? category?.Name ?? "Ohne Kategorie",
                Limit = limit,
                Spent = transactions.Sum(t => t.Amount),
                Icon = UiHelpers.Icon(icon ?? category?.Icon),
                AvatarColor = ParseColor(color ?? category?.Color ?? "Default"),
                Transactions = transactions
            };
        }

        // Kategorie-Budgets, auf Monatsbasis umgerechnet
        _budgets = Finance.Budgets
            .Where(b => b.CategoryId != null)
            .GroupBy(b => b.CategoryId)
            .Select(g => BuildRow(g.Key, g.Sum(FinanceState.MonthlyLimit), g.First().Name, g.First().Icon, g.First().Color))
            .OrderByDescending(r => r.Percent)
            .ToList();

        var budgetedIds = Finance.Budgets.Where(b => b.CategoryId != null).Select(b => b.CategoryId).ToHashSet();
        _unbudgetedSpent = expenses.Where(t => !budgetedIds.Contains(t.CategoryId)).Sum(t => t.Amount);

        // Alle Kategorien mit Ausgaben im Monat
        _topCategories = expenses
            .GroupBy(t => t.CategoryId)
            .Select(g =>
            {
                var budgetRow = _budgets.FirstOrDefault(b => b.CategoryId == g.Key);
                return budgetRow ?? BuildRow(g.Key, 0);
            })
            .OrderByDescending(r => r.Spent)
            .ToList();

        // Monatsvergleich (echte Werte)
        var spent = expenses.Sum(t => t.Amount);
        var previous = Finance.MonthExpenses(start.AddMonths(-1));
        var avg3 = Enumerable.Range(1, 3).Select(i => Finance.MonthExpenses(start.AddMonths(-i))).Average();
        var max = new[] { spent, previous, avg3, 1m }.Max();
        double Delta(decimal current, decimal reference) => reference > 0 ? (double)((current - reference) / reference * 100) : 0;
        _monthlyComparison = new List<MonthEntry>
        {
            new(start == FinanceState.MonthStart(DateTime.Today) ? "Aktueller Monat" : MonthYear(start), spent, Delta(spent, previous), (double)(spent / max * 100)),
            new("Vormonat", previous, 0, (double)(previous / max * 100)),
            new("Ø letzte 3 Mon.", Math.Round(avg3, 2), 0, (double)(avg3 / max * 100)),
        };

        // Kumulierter Verlauf: dieser Monat vs. Vormonat
        var days = DateTime.DaysInMonth(start.Year, start.Month);
        var lastDay = start == FinanceState.MonthStart(DateTime.Today) ? DateTime.Today.Day : days;
        var prevStart = start.AddMonths(-1);
        var prevDays = DateTime.DaysInMonth(prevStart.Year, prevStart.Month);
        var prevExpenses = Finance.InRange(prevStart, start).Where(t => t.Type == TransactionType.Ausgabe).ToList();

        double[] Cumulative(IEnumerable<Transaction> items, int upTo, int maxDay) =>
            Enumerable.Range(1, upTo).Select(d => d <= upTo
                ? (double)items.Where(t => t.Date.Day <= Math.Min(d, maxDay)).Sum(t => t.Amount)
                : double.NaN).ToArray();

        _burnLabels = Enumerable.Range(1, days).Select(d => d == 1 || d % 5 == 0 ? d.ToString() : "").ToArray();
        _burnSeries = new()
        {
            new ChartSeries { Name = MonthYear(start), Data = Cumulative(expenses, lastDay, days) },
            new ChartSeries { Name = MonthYear(prevStart), Data = Cumulative(prevExpenses, days, prevDays) }
        };
        if (TotalBudget > 0)
            _burnSeries.Add(new ChartSeries { Name = "Budget", Data = Enumerable.Repeat((double)TotalBudget, days).ToArray() });
    }

    // ── Computed ──────────────────────────────────────────────────────────────

    private decimal TotalBudget    => _budgets.Sum(b => b.Limit);
    private decimal TotalSpent     => _budgets.Sum(b => b.Spent);
    private decimal TotalSpentAll  => _topCategories.Sum(b => b.Spent);
    private decimal TotalRemaining => TotalBudget - TotalSpent;
    private double  SpentPercent   => TotalBudget > 0 ? (double)(TotalSpent / TotalBudget * 100) : 0;
    private int     OverBudgetCount => _budgets.Count(b => b.Spent > b.Limit);

    private Color StatusColor(double pct) =>
        pct >= 100 ? Color.Error : pct >= Preferences.BudgetWarningPercent ? Color.Warning : Color.Success;

    private IEnumerable<CategoryRow> FilteredTableBudgets => _tableFilter switch
    {
        "over" => _budgets.Where(b => b.Spent > b.Limit),
        "ok"   => _budgets.Where(b => b.Spent <= b.Limit),
        _      => _budgets
    };

    private IEnumerable<InsightItem> Insights
    {
        get
        {
            var list = new List<InsightItem>();

            if (OverBudgetCount > 0)
                list.Add(new($"{OverBudgetCount} {(OverBudgetCount == 1 ? "Kategorie überschreitet" : "Kategorien überschreiten")} das Budget.",
                    Severity.Error, Icons.Material.Filled.ErrorOutline));

            var critical = _budgets.Where(b => b.Percent >= Preferences.BudgetWarningPercent && b.Percent < 100).ToList();
            if (critical.Any())
                list.Add(new($"{string.Join(", ", critical.Select(b => b.Name))} nähert sich dem Limit.",
                    Severity.Warning, Icons.Material.Filled.WarningAmber));

            var best = _budgets.Where(b => b.Limit > 0).OrderBy(b => b.Percent).FirstOrDefault();
            if (best is not null)
                list.Add(new($"Beste Kontrolle: {best.Name} ({best.Percent:0}% genutzt).",
                    Severity.Success, Icons.Material.Filled.EmojiEvents));

            var current = _monthlyComparison.FirstOrDefault();
            if (current != null && Math.Abs(current.DeltaPercent) >= 10)
                list.Add(new($"Deine Ausgaben liegen {Math.Abs(current.DeltaPercent):0}% {(current.DeltaPercent > 0 ? "über" : "unter")} dem Vormonat.",
                    current.DeltaPercent > 0 ? Severity.Warning : Severity.Success, Icons.Material.Filled.CompareArrows));

            if (_income > 0)
            {
                var rate = (double)((_income - TotalSpentAll) / _income * 100);
                list.Add(new($"Sparquote: {rate:0}% deiner Einnahmen ({Money(_income)}) bleiben übrig.",
                    rate >= 10 ? Severity.Success : Severity.Info, Icons.Material.Filled.Savings));
            }

            if (TotalRemaining > 0 && _currentMonth == FinanceState.MonthStart(DateTime.Today))
            {
                var daysLeft = DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month) - DateTime.Today.Day + 1;
                list.Add(new($"Du hast noch {Money(TotalRemaining)} für den Monat übrig – ca. {Money(TotalRemaining / daysLeft)} pro Tag.",
                    Severity.Info, Icons.Material.Filled.Info));
            }

            if (list.Count == 0)
                list.Add(new("Noch nicht genug Daten für Auswertungen.", Severity.Normal, Icons.Material.Filled.Info));

            return list;
        }
    }

    // ── Navigation ────────────────────────────────────────────────────────────

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        Compute();
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        Compute();
    }
}
